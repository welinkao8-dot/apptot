name: Driver App - Debug APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: 'driver-portal/mobile/package-lock.json'

      - name: Install Dependencies
        working-directory: driver-portal/mobile
        run: npm install

      - name: Build Debug APK
        working-directory: driver-portal/mobile/android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Upload Debug APK
        uses: actions/upload-artifact@v4
        with:
          name: driver-app-debug-apk
          path: driver-portal/mobile/android/app/build/outputs/apk/debug/*.apk
